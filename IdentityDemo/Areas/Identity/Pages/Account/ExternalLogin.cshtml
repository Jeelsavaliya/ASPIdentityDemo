<form id="registerForm" asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3" role="alert"></div>

    <!-- Email -->
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Enter your email</label>
        <input asp-for="Input.Email" class="form-control rounded-pill" autocomplete="email" placeholder="example@gmail.com" />
        <span asp-validatio asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <!-- Submit Button -->
    <button id="registerSubmit" type="submit" class="btn btn-primary w-100 rounded-pill">Register</button>
</form>





@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
